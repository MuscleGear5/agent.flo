#!/bin/zsh
# rfl - interactive + non-interactive ruflo wrapper
# Usage:
#   rfl                       Interactive pyrfl TUI menu
#   rfl agent spawn -t coder  Non-interactive passthrough to ruflo
#   rfl --list                Dump all command paths (via pyrfl)
#   rfl --test-all            Test every command path (via pyrfl)
#   rfl --tutor               Interactive tutor (browse, learn, quiz)
#   rfl --tutor "question"    Ask the tutor anything about ruflo

SCRIPT_DIR="${0:A:h}"

# ── Dependency checks ────────────────────────────────────
typeset -a _missing=()
command -v ruflo   &>/dev/null || _missing+=("ruflo (npm i -g @claude-flow/cli@latest)")
command -v python3 &>/dev/null || _missing+=("python3 (3.10+)")
python3 -c 'import rich' 2>/dev/null || _missing+=("rich (pip install rich)")
if (( ${#_missing} > 0 )); then
  echo "Error: missing required dependencies:" >&2
  for _m in "${_missing[@]}"; do echo "  - $_m" >&2; done
  exit 1
fi

# ── Ensure pyrfl module is importable ─────────────────────
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"

# ── --list: dump all command paths ────────────────────────
if [[ "$1" == "--list" ]]; then
  exec python3 -m pyrfl --list
fi

# ── --test-all: test every command path ───────────────────
if [[ "$1" == "--test-all" ]]; then
  exec python3 -m pyrfl --test-all
fi

# ── --tutor: integrated tutoring ──────────────────────────
if [[ "$1" == "--tutor" || "$1" == "-t" ]]; then
  shift
  exec "$SCRIPT_DIR/rft" "$@"
fi

# ── Non-interactive: passthrough to ruflo ─────────────────
if [[ $# -gt 0 ]]; then
  exec ruflo "$@"
fi

# ── Interactive: launch pyrfl TUI ─────────────────────────
exec python3 -m pyrfl
